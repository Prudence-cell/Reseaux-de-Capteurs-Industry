<?xml version="1.0" encoding="UTF-8"?>
<simconf>
  <simulation>
    <title>T6 - latence, PDR, sauts (10 noeuds) (Contiki-NG)</title>
    <randomseed>123456</randomseed>
    <motedelay_us>1000000</motedelay_us>
    <radiomedium>
      org.contikios.cooja.radiomediums.UDGM
      <transmitting_range>20.0</transmitting_range>
      <interference_range>40.0</interference_range>
      <success_ratio_tx>1.0</success_ratio_tx>
      <success_ratio_rx>1.0</success_ratio_rx>
    </radiomedium>
    <events>
      <logoutput>400000</logoutput>
    </events>
    <motetype>
      org.contikios.cooja.contikimote.ContikiMoteType
      <identifier>mt_passerelle</identifier>
      <description>Passerelle GW (racine RPL)</description>
      <source>/home/ethan/projets/03_contiki_ng/passerelle/passerelle.c</source>
      <commands>$(MAKE) -j$(CPUS) passerelle.cooja TARGET=cooja</commands>
      <moteinterface>org.contikios.cooja.interfaces.Position</moteinterface>
