# Réglages communs aux 4 applications (inclus par chaque Makefile).
# -I : dossiers où nesC cherche les composants (notre dossier commun + CTP de TinyOS)
CFLAGS += -I../commun
CFLAGS += -I$(TINYOS_OS_DIR)/lib/net -I$(TINYOS_OS_DIR)/lib/net/ctp -I$(TINYOS_OS_DIR)/lib/net/4bitle
# Charge utile radio portée à 48 octets (notre rapport + en-tête CTP > 28 octets par défaut)
CFLAGS += -DTOSH_DATA_LENGTH=48
# Accusés de réception radio envoyés par la PUCE CC2420 elle-même (et non par le logiciel) :
# même quand le microcontrôleur est occupé (ex. la passerelle qui écrit sur le port série),
# l'émetteur reçoit son accusé. Nécessite la reconnaissance d'adresse matérielle.
CFLAGS += -DCC2420_HW_ACKNOWLEDGEMENTS -DCC2420_HW_ADDRESS_RECOGNITION

# make telosb CLE=0x12345678 : autre clé d'authentification (nœud « intrus » du test ENF6)
ifdef CLE
CFLAGS += -DCLE_RESEAU=$(CLE)
endif

TINYOS_ROOT_DIR ?= $(HOME)/tinyos-main
include $(TINYOS_ROOT_DIR)/Makefile.include
