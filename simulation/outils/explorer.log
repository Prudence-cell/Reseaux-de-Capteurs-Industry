public class ScriptMote {

  public Mote mote;
  public int id;
  public String lastMsg;  

  public void setMoteMsg(Mote mote, String msg) {
    this.mote = mote;
    if (mote != null) {
      id = mote.getID();
    } else {
      id = -1;
    }
    lastMsg = msg;
  }

  public void write(String data) {
    if (mote == null) return;
    mote.getInterfaces().getSerialPort().writeString(data);
  }
